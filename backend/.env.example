# Copy to backend/.env to override defaults in src/fantasy_helper/config.py
FH_LEAGUE_ID=1396633554
FH_SEASON=2027
FH_MY_TEAM_ID=4
# Defaults to SQLite at backend/fantasy.db. For Postgres (docker compose up -d):
# FH_DATABASE_URL=postgresql+psycopg://fantasy:fantasy@localhost:5432/fantasy
# Read settings from the deployed app secret instead (needs `uv run --extra aws` and an AWS
# profile); values set here or in the environment still win:
# FH_SECRET_ID=fantasy-helper/app
# Seconds after a successful ingest during which Refresh returns that run (deployed: 120):
# FH_REFRESH_COOLDOWN_SECONDS=0
# Private leagues only:
# FH_ESPN_S2=
# FH_SWID=
